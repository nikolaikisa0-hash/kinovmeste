// Cloudflare Workers: бесплатный хостинг без карты.
// Cloudflare сам собирает и выкладывает сайт из GitHub-репозитория.
{
  "name": "kinovmeste",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // static/index.html встраивается в Worker как текст (import в worker/index.js)
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      // реестр активных комнат для панели /admin
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  // SQLite-хранилище — единственный вариант Durable Objects на бесплатном плане
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Registry"] }
  ]
}
